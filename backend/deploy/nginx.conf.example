# Group Planning Assistant — nginx reverse proxy (roadmap B-154).
#
# The manual path: nginx terminates TLS with certificates
# the operator supplies (certbot is the usual source). Copy
# into /etc/nginx/sites-available/gpa, replace the site
# address and certificate paths, link into sites-enabled,
# `nginx -t`, reload. The full guide is deploy/PROXY.md.
#
# The same two rules as the Caddyfile:
#   1. client_max_body_size MATCHES the app's upload limit
#      (GPA_MAX_UPLOAD_BYTES, default 10 MiB) — nginx's "m"
#      is mebibytes, so 10m is exactly the app's 10485760.
#   2. The feed-token path is never written to an access
#      log: its location block turns logging off. Tokens
#      ride in URLs on the feed/invite/email-in paths in
#      this product; a log file must not become a copy of
#      them (the app itself holds the same line — B-145).

upstream gpa_api {
    server 127.0.0.1:8000;
}

server {
    listen 80;
    server_name planning.example.org;
    # Everything goes to HTTPS; nothing else is served here.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name planning.example.org;

    ssl_certificate     /etc/letsencrypt/live/planning.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/planning.example.org/privkey.pem;

    # HSTS: once a browser has seen this site over TLS, it
    # refuses plain HTTP for a year.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 10m;

    # The calendar feed — the token IS the path. No logging.
    location ~ ^/api/v1/calendar/feed/ {
        access_log off;
        proxy_pass http://gpa_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The event stream (SSE): never buffered.
    location ~ ^/api/v1/groups/[^/]+/stream$ {
        proxy_pass http://gpa_api;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://gpa_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
