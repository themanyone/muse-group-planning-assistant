# Group Planning Assistant — every setting, documented (roadmap B-001).
# Copy to `.env` and fill in real values. `.env` is never committed.
# All settings use the GPA_ prefix (roadmap B-002).

# Environment name: dev | test | prod. In prod, the app refuses to
# start with the development secret key below.
GPA_ENV=dev

# Database URL. SQLite by default (WAL + synchronous=FULL are applied
# by the code, roadmap B-003); a PostgreSQL URL is the documented
# swap-point for later (roadmap D-06).
GPA_DATABASE_URL=sqlite:///./data/gpa.db

# Secret used to sign access tokens and hash one-time tokens.
# REQUIRED in prod — generate a long random value and keep it secret.
GPA_SECRET_KEY=dev-only-change-me

# Token lifetimes.
GPA_ACCESS_TOKEN_MINUTES=15
GPA_REFRESH_TOKEN_DAYS=30
GPA_MAGIC_LINK_MINUTES=30

# Where uploaded files live (content-addressed local store, B-007)
# and where the dev mail driver writes outgoing mail as files (B-012).
GPA_STORAGE_DIR=./data/storage
GPA_OUTBOX_DIR=./data/outbox

# Auth rate limit: attempts per minute per IP on auth routes (B-021).
GPA_AUTH_RATE_PER_MINUTE=30

# File ingest (B-025): largest single upload in bytes. Oversize,
# executable, and unreadable uploads are refused before storage.
GPA_MAX_UPLOAD_BYTES=10485760

# Background jobs: max attempts before a job is dead-lettered (B-008),
# and the base delay (seconds) for exponential backoff.
GPA_JOB_MAX_ATTEMPTS=5
GPA_JOB_BACKOFF_BASE_SECONDS=5

# Job queue backend (B-157, D-09): "database" (the default — the job
# table itself, safe across many worker processes) or "arq" (an
# external Redis queue behind the same interface, for deployments
# that outgrow one box; needs the `queue` install extra and the
# Redis address below).
GPA_JOB_QUEUE=database
GPA_REDIS_URL=

# MCP server (B-204): the streamable-HTTP transport's bind address
# for `gpa-mcp --transport streamable-http`. Loopback by default —
# remote exposure rides the deployment proxy, and B-205's
# authentication lands before any wider bind. Stdio ignores these.
GPA_MCP_HTTP_HOST=127.0.0.1
GPA_MCP_HTTP_PORT=8765

# MCP sampling policy (B-217): server-initiated sampling (the
# server asking the connected client's model to generate text)
# is OFF by default — it spends the client operator's model
# budget on server-chosen prompts, through a model this
# deployment does not control (Doc 13 states the reason in
# full). Set the first line to true only as a deliberate
# operator act. The caps bound one call's generation (tokens)
# and one group's sampling calls per UTC day, counted on the
# AI usage ledger (B-047).
GPA_MCP_SAMPLING_ENABLED=false
GPA_MCP_SAMPLING_MAX_TOKENS=512
GPA_MCP_SAMPLING_MAX_CALLS_PER_DAY=20

# MCP security hardening (B-218): the most MCP tool calls one
# principal may make per minute at the gateway — a brake
# against a runaway agent loop, counted per principal.
# 0 disables the brake deliberately.
GPA_MCP_RATE_LIMIT_PER_MINUTE=600

# Link ingest (B-029): page-fetch timeout (seconds) and the largest
# archived page body in bytes. The SSRF guards are NOT settings —
# private/metadata addresses are refused in code, always.
GPA_LINK_FETCH_TIMEOUT_SECONDS=10
GPA_LINK_FETCH_MAX_BYTES=2097152

# Create tables automatically at startup (dev/demo convenience).
# In production, run Alembic migrations instead and set this to false.
GPA_AUTO_CREATE_TABLES=true

# AI adapter (Phase 3, B-035 → B-037): mock | fixture | live.
# mock (default) and fixture run fully offline — no key, no network.
GPA_AI_DRIVER=mock
# Fixture driver recordings directory (empty = the package default).
GPA_AI_FIXTURES_DIR=
# Live driver only: the Meta Model API base URL, and its key.
# THE KEY IS A SECRET: environment only, never committed anywhere.
GPA_AI_API_BASE=
GPA_AI_API_KEY=
# Live driver model ids per tier, timeout, attempts (429/5xx retries).
GPA_AI_MODEL_SPARK=muse-spark
GPA_AI_MODEL_WONDER=muse-wonder
GPA_AI_LIVE_TIMEOUT_SECONDS=30
GPA_AI_LIVE_MAX_ATTEMPTS=3
# Live driver prices per 1k tokens, in micro-units (B-037 cost
# accounting). 0 = not configured; the ledger records tokens and 0.
GPA_AI_PRICE_SPARK_MICROS_PER_1K=0
GPA_AI_PRICE_WONDER_MICROS_PER_1K=0

# Mail transport (B-095): file (dev — messages land as JSON files in
# GPA_OUTBOX_DIR) or smtp (B-133's real provider driver).
GPA_MAIL_TRANSPORT=file
# SMTP provider (B-133; see DEPLOYMENT.md for SPF/DKIM/DMARC setup).
# The password is a SECRET: environment only, never committed.
GPA_MAIL_SMTP_HOST=
GPA_MAIL_SMTP_PORT=587
GPA_MAIL_SMTP_USERNAME=
GPA_MAIL_SMTP_PASSWORD=
GPA_MAIL_SMTP_USE_TLS=true
GPA_MAIL_FROM_ADDRESS=
# Provider bounce-webhook shared secret (B-133). When set, the mail
# webhook demands a verifying HMAC signature; empty = dev posture.
GPA_MAIL_WEBHOOK_SECRET=

# Integration sealing key (B-127). Empty = use the app secret.
GPA_INTEGRATION_KEY=

# Public origin invite links are built on (B-098). Empty = path-only.
GPA_PUBLIC_BASE_URL=
